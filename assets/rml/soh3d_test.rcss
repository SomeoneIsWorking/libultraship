/* SoH3D RmlUi menu stylesheet. Phase 2: a focusable settings list with a clear focus highlight
   and native checkbox toggle state. The font family must match the name embedded in the TTF
   (RmlUi reports it as "LatoLatin"). */

body {
	font-family: LatoLatin;
	font-weight: normal;
	font-style: normal;
	font-size: 18px;
	color: #e8e8f0;
}

#panel {
	width: 460px;
	margin: 60px auto 0 auto;
	padding: 24px 28px;
	background-color: #16203aee;
	border: 2px #5a7fd0ff;
	border-radius: 10px;
	box-shadow: 0 6px 24px #000000aa;
}

#panel h1 {
	font-size: 30px;
	font-weight: bold;
	color: #8fb6ff;
	margin-bottom: 4px;
}

.subtitle {
	color: #7c89a8;
	font-size: 14px;
	margin-bottom: 18px;
}

.hint {
	color: #6c789a;
	font-size: 13px;
	margin-top: 16px;
}

/* A settings row takes focus as a whole so navigation is obvious; the focused row lights up. */
.row {
	display: block;
	padding: 10px 14px;
	margin-bottom: 6px;
	border-radius: 6px;
	background-color: #1e2a48cc;
	border: 2px #1e2a4800; /* reserve the focus-border width so layout does not shift on focus */
}

.row:focus {
	background-color: #2c416e;
	border: 2px #8fb6ffff;
}

.row .label {
	display: inline-block;
	width: 360px;
	vertical-align: middle;
}

/* Native checkbox: an 18px box that fills when checked. */
input.checkbox {
	display: inline-block;
	width: 18px;
	height: 18px;
	vertical-align: middle;
	border-radius: 4px;
	border: 2px #8fb6ffff;
	background-color: #0c1322;
}

input.checkbox:checked {
	background-color: #5dff8f;
	border-color: #5dff8f;
}
